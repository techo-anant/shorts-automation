# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Injected automatically by Railway. Set manually for local dev.
DATABASE_URL=postgresql://user:password@localhost:5432/shorts_automation

# --- Google Drive ---
DRIVE_SHORTS_ROOT_FOLDER_ID=<your-drive-shorts-root-folder-id>

# --- Google OAuth (Drive + YouTube) ---
# Create credentials in Google Cloud Console (Desktop app, OAuth 2.0).
# Enable: Google Drive API, YouTube Data API v3.
# Generate the refresh token with: uv run python scripts/get_refresh_token.py
GOOGLE_OAUTH_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-<your-client-secret>
GOOGLE_OAUTH_REFRESH_TOKEN=<generated-by-get_refresh_token.py>

# --- AI Services ---
GEMINI_API_KEY=<your-gemini-api-key>
TWELVELABS_API_KEY=tlk_<your-twelvelabs-api-key>

# --- Discord Notifications ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Set to true to also ping on successful runs (default: false)
DISCORD_SUCCESS_PINGS=false
DISCORD_BOT_TOKEN=<your-discord-bot-token>
DISCORD_APPROVAL_CHANNEL_ID=<your-approval-channel-id>

# --- Polling ---
POLL_INTERVAL_SECONDS=300

# --- Cost Circuit Breakers ---
COST_WARN_USD=5.00
COST_HARD_STOP_USD=8.00

# --- Server ---
# Railway injects PORT automatically. Set for local dev.
PORT=8080
